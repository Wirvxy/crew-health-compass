# Backend settings (api/). All are optional: the defaults work from a fresh clone.
# The API reads these from the environment; nothing loads this file automatically.
# PowerShell example:  $env:CREW_HEALTH_DB_PATH = "C:\path\to\crew_health.db"

# SQLite file for the hash-chained audit log (the folder must exist)
CREW_HEALTH_DB_PATH=api/crew_health.db
# Folder with the four OSD-575 *_TRANSFORMED.csv files (Mode 2)
CREW_HEALTH_OSD575_DIR=download
# Folder or ZIP with Person B's synthetic iss-synthetic-3000 dataset (Mode 1)
CREW_HEALTH_MODE1_DATA=iss-synthetic-3000
# The Curiosity RAD radiation CSV (Mission Environment)
CREW_HEALTH_RAD_CSV=raw data/NASA Curiosity radiation/nasa_curiosity_rad_2024-03-07_to_2024-05-20.csv
