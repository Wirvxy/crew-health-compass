# Files Git must not track in this repository.
# Ignoring is not a guarantee: it does not affect files that are already tracked,
# `git add -f` overrides it, and it cannot see a secret pasted into a normal file.
# Check your diff before every commit.

# Secrets and local settings (copy an .env.example file, then fill in values)
.env
.env.*
!.env.example
*.key
*.pem

# Local databases (the API's SQLite file defaults to api/crew_health.db)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/

# Node and the frontend build
node_modules/
dist/
*.tsbuildinfo

# Logs, operating-system and editor files
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
